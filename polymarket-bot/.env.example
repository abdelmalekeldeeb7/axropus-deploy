# Copy to .env and fill in values

# Polymarket
POLY_PRIVATE_KEY=0x...your_private_key...
POLY_PROXY_WALLET=0x...your_proxy_wallet...

# Paper mode (auto-switches to live after 20 trades at 58%+ WR)
PAPER_MODE=true
PAPER_MIN_WR=0.58
PAPER_MIN_TRADES=20

# Bankroll and sizing
BANKROLL=300.0
TRADE_SIZE_USD=15.0        # $15/trade ($150 deployed per cycle)

# Cycle config
CYCLE_SECONDS=15.0
MAX_SIGNALS_CYCLE=10       # 10 trades per 15-min cycle

# Active hours (UTC) — skip dead hours
ACTIVE_HOUR_START=8
ACTIVE_HOUR_END=22

# Volume gate — BTC must move this % in last 5 min to trade
MIN_BTC_MOVE_PCT=0.05

# Conviction — strategies that must agree before firing
# 1 = any single strategy fires
# 2 = two strategies must agree (higher WR, fewer trades)
MIN_CONVICTION=2

# ── AMF Full Stack (from axropus-deploy repo) ──────────────────────────────
# vLLM + VRAM KV cache (prefix caching — 0.01s on repeated questions)
VLLM_ENDPOINT=http://localhost:8000

# Dynamo coordinator (routes to fastest worker)
AMF_COORDINATOR_URL=http://localhost:9000

# LMCache persistent KV blocks (survives restarts)
KORITH_LMCACHE_URL=http://localhost:8100
KORITH_LMCACHE_ENABLED=1
KORITH_LMCACHE_BLOCK_SIZE=16

# LLM model (Qwen2.5 14B recommended for RTX 5060 16GB)
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=qwen2.5:14b

# DeepSeek API fallback (only if all local LLMs are down)
DEEPSEEK_API_KEY=

# Optional: News API for event markets (Strategy 5)
NEWS_API_KEY=

# Whale wallets for copy trading (comma-separated)
# Leave empty to use built-in defaults
WHALE_WALLETS=
