FROM python:3.11-slim

WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir pyyaml
ENV PYTHONPATH=/app
ENV KORITH_PLATFORM_CONFIG=/config/config.yaml

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/v1/health', timeout=2).read()"
CMD ["python", "-m", "platform.runtime.router_service", "--host", "0.0.0.0", "--port", "8000", "--config", "/config/config.yaml"]
