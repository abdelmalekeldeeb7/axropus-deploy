FROM python:3.11-slim

WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir pyyaml
ENV PYTHONPATH=/app
ENV KORITH_GATEWAY_ROUTER_URL=http://router:8000

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/v1/health', timeout=2).read()"
CMD ["python", "-m", "platform.gateway.proxy_server", "--host", "0.0.0.0", "--port", "8080"]
