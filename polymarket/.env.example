# Copy to .env and fill in values

# Polymarket
POLY_PRIVATE_KEY=0x...your_private_key...
POLY_PROXY_WALLET=0x...your_proxy_wallet...

# Paper trading (set false to go live)
PAPER_MODE=true

# Bankroll and sizing
BANKROLL=300.0
TRADE_SIZE_USD=10.0

# Cycle config
CYCLE_SECONDS=15.0
MAX_SIGNALS_CYCLE=3

# LLM (local Ollama default, or vLLM endpoint)
LLM_ENDPOINT=http://localhost:11434

# DeepSeek API fallback (only used if local LLM is down)
DEEPSEEK_API_KEY=

# Optional: News API for event markets (Strategy 5)
NEWS_API_KEY=

# Optional: whale wallets to copy (comma-separated, Strategy 7)
WHALE_WALLETS=0xWallet1,0xWallet2
