# Axropus AMF serving stack config.
#
# Copy this file to configs/amf_stack.env, edit the model/memory values, then:
#
#   ./scripts/verify_amf_stack.sh configs/amf_stack.env
#   ./scripts/start_vllm_amf_stack.sh configs/amf_stack.env

# Repository/runtime
AMF_REPO_DIR="${HOME}/amf"
PYTHON_BIN="python3"

# Model
AMF_MODEL="/home/jovyan/models/Qwen3.6-27B"
AMF_HOST="0.0.0.0"
AMF_PORT="8000"
AMF_MAX_MODEL_LEN="18432"
AMF_TENSOR_PARALLEL_SIZE="1"
AMF_MAX_NUM_SEQS="64"
AMF_GPU_MEMORY_UTILIZATION="0.90"
AMF_KV_CACHE_MEMORY_GB="8"
AMF_CPU_OFFLOAD_GB="0"
AMF_KV_CACHE_DTYPE="auto"
AMF_ENFORCE_EAGER="1"

# AMF hot tier
KORITH_ENABLE_AMF="1"
KORITH_AMF_PATH="/tmp/axropus-amf"
KORITH_AMF_VRAM_FIRST="1"
KORITH_AMF_SYNC_SAVE="1"
KORITH_AMF_MIN_TOKENS="64"
KORITH_TENANT_ID="__shared__"

# Raw AMF VRAM snapshot tier. Use this for raw, fastest restore.
KORITH_VRAM_CACHE_GB="0"
KORITH_VRAM_CACHE_DEVICE="cuda:0"

# Compressed AMF VRAM pool. Use fp8/int4 when proving same-total-memory value.
KORITH_VRAM_POOL_GB="16"
KORITH_VRAM_POOL_QUANT="fp8"

# LMCache lower tier. Keep disabled until the LMCache smoke passes on the box.
AXROPUS_ENABLE_LMCACHE="0"
AXROPUS_LMCACHE_FALLBACK="0"
AXROPUS_PROMOTE_LMCACHE_HITS="1"
AXROPUS_LMCACHE_WRITE_THROUGH="1"
AXROPUS_LMCACHE_LOOKUP_TIMEOUT_MS="200"
AXROPUS_LMCACHE_ROLE="kv_both"
AXROPUS_LMCACHE_DISCARD_PARTIAL_CHUNKS="0"
AXROPUS_LMCACHE_SKIP_LAST_N_TOKENS="0"

# LMCache env backend
LMCACHE_TRACK_USAGE="false"
LMCACHE_LOCAL_CPU="true"
LMCACHE_MAX_LOCAL_CPU_SIZE="32"
LMCACHE_CHUNK_SIZE="256"
LMCACHE_SAVE_UNFULL_CHUNK="true"

# Hugging Face / tokenizer defaults
HF_XET_HIGH_PERFORMANCE="1"
TOKENIZERS_PARALLELISM="false"
